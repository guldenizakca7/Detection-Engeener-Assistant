# LLM Provider: "ollama" (local GPU), "groq" (free cloud), "openai",
# "anthropic", "gemini", "mistral", or "together"
LLM_PROVIDER=ollama

# Groq API Key (only required if LLM_PROVIDER=groq)
# Get free key at: https://console.groq.com
GROQ_API_KEY=

# Ollama base URL (default is fine for local Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Stage 1 model (MITRE detection — Qwen2.5 Coder)
STAGE1_MODEL_OLLAMA=qwen2.5-coder:14b
STAGE1_MODEL_GROQ=llama-3.1-8b-instant

# Stage 2 model (IR generation — Llama 3.3)
STAGE2_MODEL_OLLAMA=llama3.3:70b
STAGE2_MODEL_GROQ=llama-3.3-70b-versatile

# OpenAI (only required if LLM_PROVIDER=openai)
OPENAI_API_KEY=
STAGE1_MODEL_OPENAI=gpt-4o-mini
STAGE2_MODEL_OPENAI=gpt-4o

# Anthropic (Claude) (only required if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
STAGE1_MODEL_ANTHROPIC=claude-haiku-4-5-20251001
STAGE2_MODEL_ANTHROPIC=claude-sonnet-4-6

# Google Gemini (only required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
STAGE1_MODEL_GEMINI=gemini-2.0-flash
STAGE2_MODEL_GEMINI=gemini-1.5-pro

# Mistral AI (only required if LLM_PROVIDER=mistral)
MISTRAL_API_KEY=
STAGE1_MODEL_MISTRAL=mistral-small-latest
STAGE2_MODEL_MISTRAL=mistral-large-latest

# Together AI (only required if LLM_PROVIDER=together)
TOGETHER_API_KEY=
STAGE1_MODEL_TOGETHER=Qwen/Qwen2.5-Coder-32B-Instruct
STAGE2_MODEL_TOGETHER=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Similarity thresholds for MITRE validation
THRESHOLD_AUTO=0.85
THRESHOLD_ASK=0.65

# Output directory for generated rules
OUTPUT_DIR=./output

# Data directory for MITRE JSON and ChromaDB
DATA_DIR=./data
